# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_AUTH_SECRET: Cryptographic secret key for signing secure admin session tokens.
ADMIN_AUTH_SECRET="ojas-hospital-jamnagar-secure-admin-secret-2025"

# ADMIN_DEFAULT_EMAIL: Primary hospital administration email.
ADMIN_DEFAULT_EMAIL="admin@ojashospital.com"

# ADMIN_INITIAL_PASSWORD: (Optional) Initial password for default administrator account.
ADMIN_INITIAL_PASSWORD=

# =========================================================================
# TRANSACTIONAL SMS PROVIDER CONFIGURATION (INDIA DLT COMPLIANT)
# =========================================================================
# SMS_API_KEY: Authentication authorization key provided by your Indian SMS gateway (e.g., MSG91, Textlocal, Fast2SMS, Twilio).
SMS_API_KEY=""

# SMS_SENDER_ID: Approved 6-character header / Sender ID registered on Indian DLT portal (e.g., OJASHM, OJASHP).
SMS_SENDER_ID="OJASHP"

# SMS_TEMPLATE_ID: Approved DLT Content Template ID for appointment confirmation SMS.
SMS_TEMPLATE_ID="1207161728394857291"

# SMS_API_URL: (Optional) Custom endpoint URL if using custom gateway or webhook. Defaults to MSG91 flow/send API.
SMS_API_URL=""

# SMS_PROVIDER: Provider driver identifier ('msg91', 'textlocal', 'fast2sms', or 'generic_http'). Defaults to 'msg91'.
SMS_PROVIDER="msg91"
